# ============================================
# Retail Enterprise Integration Platform
# Environment Variables
# ============================================

# JWT
JWT_SECRET=eai-retail-jwt-secret-key-2024-ultra-secure
JWT_EXPIRY=24h

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=eai_admin
RABBITMQ_PASS=eai_secret_2024
RABBITMQ_MANAGEMENT_PORT=15672

# POS Service - MySQL
POS_DB_HOST=pos-db
POS_DB_PORT=3306
POS_DB_USER=pos_user
POS_DB_PASS=pos_secret_2024
POS_DB_NAME=pos_database

# Inventory Service - PostgreSQL
INVENTORY_DB_HOST=inventory-db
INVENTORY_DB_PORT=5432
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASS=inventory_secret_2024
INVENTORY_DB_NAME=inventory_database

# Accounting Service - PostgreSQL
ACCOUNTING_DB_HOST=accounting-db
ACCOUNTING_DB_PORT=5432
ACCOUNTING_DB_USER=accounting_user
ACCOUNTING_DB_PASS=accounting_secret_2024
ACCOUNTING_DB_NAME=accounting_database

# CRM Service - MySQL
CRM_DB_HOST=crm-db
CRM_DB_PORT=3306
CRM_DB_USER=crm_user
CRM_DB_PASS=crm_secret_2024
CRM_DB_NAME=crm_database

# E-Commerce Service - PostgreSQL
ECOMMERCE_DB_HOST=ecommerce-db
ECOMMERCE_DB_PORT=5432
ECOMMERCE_DB_USER=ecommerce_user
ECOMMERCE_DB_PASS=ecommerce_secret_2024
ECOMMERCE_DB_NAME=ecommerce_database

# Service Ports
API_GATEWAY_PORT=3000
POS_SERVICE_PORT=3001
INVENTORY_SERVICE_PORT=3002
ACCOUNTING_SERVICE_PORT=3003
CRM_SERVICE_PORT=3004
ECOMMERCE_SERVICE_PORT=3005
INTEGRATION_SERVICE_PORT=3006
MESSAGE_TRANSLATOR_PORT=3007
MESSAGE_ROUTER_PORT=3008
FRONTEND_PORT=8080

# Service URLs (internal Docker network)
API_GATEWAY_URL=http://api-gateway:3000
POS_SERVICE_URL=http://pos-service:3001
INVENTORY_SERVICE_URL=http://inventory-service:3002
ACCOUNTING_SERVICE_URL=http://accounting-service:3003
CRM_SERVICE_URL=http://crm-service:3004
ECOMMERCE_SERVICE_URL=http://ecommerce-service:3005
INTEGRATION_SERVICE_URL=http://integration-service:3006
MESSAGE_TRANSLATOR_URL=http://message-translator:3007
MESSAGE_ROUTER_URL=http://message-router:3008
